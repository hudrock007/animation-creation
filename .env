# Animation Creation Environment Configuration
# Development Environment

# Server Configuration
SERVER_PORT=8000
SERVER_HOST=localhost
NODE_ENV=development

# Canvas Configuration
CANVAS_WIDTH=800
CANVAS_HEIGHT=480
DEFAULT_FPS=60
DEFAULT_DURATION=10

# Plugin Configuration
ENABLE_GLOW_PLUGIN=true
ENABLE_DUST_PLUGIN=true
ENABLE_TRAILS_PLUGIN=true

# Feature Flags
ENABLE_EXPORT=true
ENABLE_PRESETS=true
ENABLE_KEYFRAME_EDITING=true

# Logging
DEBUG_MODE=true
LOG_LEVEL=debug

# Export Options
EXPORT_FORMAT=json
EXPORT_DIRECTORY=./exports
AUTO_SAVE_ENABLED=false
AUTO_SAVE_INTERVAL=30000
